---
// The one layout: a title line, a few links, the page. Modelled on Tao's
// optimization-constants site (teorth.github.io/optimizationproblems): no
// sidebar, no table of contents, the table is the site.
interface Props {
	title: string;
	description: string;
	home?: boolean;
}
const { title, description, home = false } = Astro.props;
const pageTitle = home ? title : `${title} · Solved Games`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<!-- GA4, the same property as brianhliou.com (filter by hostname); the loader is brianhliou.com's, with its ?notrack owner opt-out. -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XX833SP2K2"></script>
		<script is:inline src="/google-analytics.js" defer data-ga-id="G-XX833SP2K2"></script>
	</head>
	<body>
		<header>
			<a class="site" href="/">Solved Games</a>
			<nav>
				<a href="/">Games</a>
				<a href="/open-problems/">Open problems</a>
				<a href="/engines/">Engines</a>
				<a href="https://github.com/brianhliou/solved-games">GitHub</a>
			</nav>
		</header>
		<main>
			<h1>{title}</h1>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	:root {
		--bg: #ffffff;
		--text: #1f2328;
		--muted: #59636e;
		--link: #0969da;
		--border: #d1d9e0;
		--stripe: #f6f8fa;
		--quote: #f6f8fa;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0d1117;
			--text: #e6edf3;
			--muted: #9198a1;
			--link: #4493f8;
			--border: #3d444d;
			--stripe: #151b23;
			--quote: #151b23;
		}
	}
	* {
		box-sizing: border-box;
	}
	html {
		-webkit-text-size-adjust: 100%;
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font: 16px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
	}
	header,
	main {
		max-width: 1012px;
		margin: 0 auto;
		padding: 0 16px;
	}
	header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 24px;
		padding-top: 16px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--border);
	}
	header .site {
		font-weight: 600;
		color: var(--text);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 16px;
		font-size: 14px;
	}
	nav a {
		color: var(--muted);
	}
	main {
		padding-bottom: 48px;
		/* Bare URLs in the resource lists are one long word. */
		overflow-wrap: break-word;
	}
	a {
		color: var(--link);
		text-decoration: none;
	}
	a:hover {
		text-decoration: underline;
	}
	h1,
	h2,
	h3 {
		font-weight: 600;
		line-height: 1.25;
		margin: 24px 0 16px;
	}
	h1 {
		font-size: 2em;
		padding-bottom: 0.3em;
		border-bottom: 1px solid var(--border);
	}
	h2 {
		font-size: 1.5em;
		padding-bottom: 0.3em;
		border-bottom: 1px solid var(--border);
	}
	h3 {
		font-size: 1.25em;
	}
	p,
	ul,
	ol,
	table,
	blockquote {
		margin: 0 0 16px;
	}
	blockquote {
		padding: 8px 16px;
		background: var(--quote);
		border-left: 4px solid var(--border);
	}
	blockquote > :last-child {
		margin-bottom: 0;
	}
	code {
		font-size: 85%;
		padding: 0.2em 0.4em;
		background: var(--stripe);
		border-radius: 6px;
	}
	table {
		display: block;
		width: max-content;
		max-width: 100%;
		overflow-x: auto;
		border-collapse: collapse;
	}
	th,
	td {
		padding: 6px 13px;
		border: 1px solid var(--border);
		text-align: left;
		vertical-align: top;
	}
	th {
		font-weight: 600;
	}
	tbody tr:nth-child(2n) {
		background: var(--stripe);
	}
	/* The generated data sheets use a header-less two-column table ("| | |"). */
	thead:has(th:empty:first-child + th:empty:last-child) {
		display: none;
	}
	iframe {
		display: block;
		width: 100%;
		height: 860px;
		border: 1px solid var(--border);
		border-radius: 6px;
	}
	.muted {
		color: var(--muted);
	}
</style>
